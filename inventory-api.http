### ====================================================================
### Inventory Dashboard API - v2 HTTP Request Collection
### Base URL: http://localhost:8000/api/v1
### Compatible with: VS Code REST Client, JetBrains HTTP Client, Postman
### ====================================================================

@baseUrl = http://localhost:8000/api/v1
@contentType = application/json

### --------------------------------------------------------------------
### 1. AUTHENTICATION
### --------------------------------------------------------------------

# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "admin@example.com",
  "password": "password"
}

### Save Admin Token
@adminToken = {{loginAdmin.response.body.data.token}}

###

# @name loginStaff
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "staff@example.com",
  "password": "password"
}

### Save Staff Token
@staffToken = {{loginStaff.response.body.data.token}}

###

# @name getCurrentUser
GET {{baseUrl}}/auth/me
Authorization: Bearer {{adminToken}}
Accept: {{contentType}}

###

# @name registerUserAdminOnly
POST {{baseUrl}}/auth/register
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "name": "Jane Supervisor",
  "email": "jane@example.com",
  "password": "password123",
  "password_confirmation": "password123",
  "role": "staff"
}

###

# @name logoutUser
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}


### --------------------------------------------------------------------
### 2. DASHBOARD
### --------------------------------------------------------------------

# @name getDashboardStats
GET {{baseUrl}}/dashboard/stats
Authorization: Bearer {{adminToken}}
Accept: {{contentType}}


### --------------------------------------------------------------------
### 3. CATEGORIES
### --------------------------------------------------------------------

# @name listCategories
GET {{baseUrl}}/categories?sort_by=name&direction=asc&per_page=10
Authorization: Bearer {{adminToken}}
Accept: {{contentType}}

###

# @name createCategory
# @prompt categoryName Enter category name
POST {{baseUrl}}/categories
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "name": "Audio Equipment",
  "description": "Headphones, microphones, and studio audio interfaces.",
  "is_active": true
}

###

# @name getCategoryById
GET {{baseUrl}}/categories/1
Authorization: Bearer {{adminToken}}
Accept: {{contentType}}

###

# @name updateCategory
PUT {{baseUrl}}/categories/1
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "name": "Pro Audio Gear",
  "description": "Professional recording and broadcast equipment.",
  "is_active": true
}

###

# @name deleteCategoryAdminOnly
DELETE {{baseUrl}}/categories/1
Authorization: Bearer {{adminToken}}
Accept: {{contentType}}

###

# @name restoreCategoryAdminOnly
POST {{baseUrl}}/categories/1/restore
Authorization: Bearer {{adminToken}}
Accept: {{contentType}}


### --------------------------------------------------------------------
### 4. PRODUCTS
### --------------------------------------------------------------------

# @name listProductsFilteredAndSorted
GET {{baseUrl}}/products?search=&status=active&low_stock=0&sort_by=created_at&direction=desc&per_page=10
Authorization: Bearer {{adminToken}}
Accept: {{contentType}}

###

# @name listLowStockProducts
GET {{baseUrl}}/products?low_stock=1
Authorization: Bearer {{adminToken}}
Accept: {{contentType}}

###

# @name createProductWithInitialMovement
POST {{baseUrl}}/products
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "category_id": 1,
  "name": "Studio Condenser Mic",
  "sku": "MIC-STUDIO-001",
  "price": 149.99,
  "stock": 25,
  "reorder_level": 10,
  "status": "active",
  "reason": "Supplier shipment intake batch #104"
}

###

# @name getProductById
GET {{baseUrl}}/products/1
Authorization: Bearer {{adminToken}}
Accept: {{contentType}}

###

# @name updateProductWithStockDeltaAndReason
PUT {{baseUrl}}/products/1
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
  "category_id": 1,
  "name": "Studio Condenser Mic (V2 Edition)",
  "sku": "MIC-STUDIO-001",
  "price": 159.99,
  "stock": 35,
  "reorder_level": 12,
  "status": "active",
  "reason": "Restocked +10 units from central depot"
}

###

# @name getProductStockMovementsAuditHistory
GET {{baseUrl}}/products/1/movements
Authorization: Bearer {{adminToken}}
Accept: {{contentType}}

###

# @name deleteProductAdminOnly
DELETE {{baseUrl}}/products/1
Authorization: Bearer {{adminToken}}
Accept: {{contentType}}

###

# @name restoreProductAdminOnly
POST {{baseUrl}}/products/1/restore
Authorization: Bearer {{adminToken}}
Accept: {{contentType}}


### --------------------------------------------------------------------
### 5. REPORTS & EXPORTS
### --------------------------------------------------------------------

# @name exportInventoryReportCsv
GET {{baseUrl}}/reports/inventory/export
Authorization: Bearer {{adminToken}}

###

# @name exportFilteredInventoryReportCsv
GET {{baseUrl}}/reports/inventory/export?low_stock=1
Authorization: Bearer {{adminToken}}

###

# @name exportProductsCsvAlias
GET {{baseUrl}}/products/export
Authorization: Bearer {{adminToken}}
